  <string id="tor_hirelingactivity1.ImperialEngineer" text="{=str_tor_hirelingactivity1_ImperialEngineer}Maintain the army's cannons" />
  <string id="tor_hirelingactivity2.ImperialEngineer" text="{=str_tor_hirelingactivity2_ImperialEngineer}Drill the troops in volley fire" />
  <string id="tor_hirelingactivity3.ImperialEngineer" text="{=str_tor_hirelingactivity3_ImperialEngineer}Patch up your powder burns" />
  <string id="tor_hirelingactivity4.ImperialEngineer" text="{=str_tor_hirelingactivity4_ImperialEngineer}Haggle with the powder merchants" />

