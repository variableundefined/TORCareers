  <string id="imperial_engineer_ScatterShot_tooltip_str" text="Load Scatter Shot: fires 6 musket balls in a spread (5 on repeaters), each dealing 50% damage (40% on repeaters). Affected by 'Pack It In'. 5% misfire chance." />
  <string id="imperial_engineer_ExplosiveShot_label_str" text="Explosive Shot" />
  <string id="imperial_engineer_ExplosiveShot_tooltip_str" text="Load Explosive Shot: explodes where it lands for up to 60% of the shot's damage as 'Fire' in 3m (40% on repeaters, none on blunderbusses). 8% misfire chance." />
