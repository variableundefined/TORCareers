<strings>
  <string id="tor_career_title.ImperialEngineer" text="{=str_tor_career_title_ImperialEngineer}Imperial Engineer" />
  <string id="tor_career_description.ImperialEngineer" text="{=str_tor_career_description_ImperialEngineer}Engineers are learned and prestigious men of the Empire whose inventions ease the lives of many. More often than not, however, they turn their attention to the ceaseless wars that plague the Empire, where their innovative but unreliable creations turn the tide against humanity's many foes. Though it is neither as profitable nor as safe as maintaining the machines of the mines, there is plenty of work, joy and danger for anyone who seeks to push the boundaries of human science." />

  <string id="tor_career_rank1_name.ImperialEngineer" text="{=str_tor_career_rank1_name_ImperialEngineer}Apprentice Engineer" />
  <string id="tor_career_rank2_name.ImperialEngineer" text="{=str_tor_career_rank2_name_ImperialEngineer}Associate Engineer" />
  <string id="tor_career_rank3_name.ImperialEngineer" text="{=str_tor_career_rank3_name_ImperialEngineer}Master Engineer" />

