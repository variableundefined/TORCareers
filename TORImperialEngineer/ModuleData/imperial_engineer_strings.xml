  <string id="tor_careerchoice_description.ImperialEngineerRoot" text="{=str_ie_root}Load experimental munitions into your gun. Gain 3 shots, plus 1 additional shot per 50 points in 'Gunpowder'. Choose the ammunition type from the ability wheel. Does not affect grenades. Shots can misfire: Heavy 3%, Scatter 5%, Explosive 8%. (Ability charges by dealing melee or ranged damage.)" />

  <string id="tor_careerchoice_description.ImperialLogisticsPassive1" text="{=str_ie_log1}+5 ammunition per ammunition pouch you have equipped." />
  <string id="tor_careerchoice_description.ImperialLogisticsPassive2" text="{=str_ie_log2}-25% wages for 'Ranged' troops, including Outriders." />
  <string id="tor_careerchoice_description.ImperialLogisticsPassive3" text="{=str_ie_log3}-25% 'Prestige' cost for 'Ranged' and 'Engineer' troop upgrades." />
  <string id="tor_careerchoice_description.ImperialLogisticsPassive4" text="{=str_ie_log4}+1 party movement speed on the campaign map." />
  <string id="tor_careerchoice_description.ImperialLogisticsKeystone" text="{=str_ie_logks}Experimental Munition also scales with 'Engineering', and can be used at battle start." />

  <string id="tor_careerchoice_description.CustomizedWeaponsPassive1" text="{=str_ie_cus1}+10 personal Hitpoints." />
  <string id="tor_careerchoice_description.CustomizedWeaponsPassive2" text="{=str_ie_cus2}+10% personal ranged 'Physical' damage." />
  <string id="tor_careerchoice_description.CustomizedWeaponsPassive3" text="{=str_ie_cus3}+15% personal missile speed." />
  <string id="tor_careerchoice_description.CustomizedWeaponsPassive4" text="{=str_ie_cus4}Gain 'Engineering' experience for each ranged kill, scaled by the victim's level." />
  <string id="tor_careerchoice_description.CustomizedWeaponsKeystone" text="{=str_ie_cusks}Experimental Munition gains +2 shots and grants +50% reload speed." />

  <string id="tor_careerchoice_description.ImperialSchoolOfEngineersPassive1" text="{=str_ie_sch1}+25% personal 'Fire' resistance." />
  <string id="tor_careerchoice_description.ImperialSchoolOfEngineersPassive2" text="{=str_ie_sch2}+15 personal Hitpoints." />
  <string id="tor_careerchoice_description.ImperialSchoolOfEngineersPassive3" text="{=str_ie_sch3}+6 ammunition per ammunition or buckshot pouch you have equipped, +3 per grenade pouch." />
  <string id="tor_careerchoice_description.ImperialSchoolOfEngineersPassive4" text="{=str_ie_sch4}+25 daily experience for each 'Ranged' and 'Engineer' troop." />
  <string id="tor_careerchoice_description.ImperialSchoolOfEngineersKeystone" text="{=str_ie_schks}Heavy Shot pierces targets. Gains immunity to knockdown from misfires." />

  <string id="tor_careerchoice_description.ImperialGunnerySchoolPassive1" text="{=str_ie_gun1}+20% party spotting range on the campaign map." />
  <string id="tor_careerchoice_description.ImperialGunnerySchoolPassive2" text="{=str_ie_gun2}+10% 'Physical' damage for 'Gunpowder' troops." />
  <string id="tor_careerchoice_description.ImperialGunnerySchoolPassive3" text="{=str_ie_gun3}+10% accuracy for 'Gunpowder' troops." />
  <string id="tor_careerchoice_description.ImperialGunnerySchoolPassive4" text="{=str_ie_gun4}+6 ammunition per ammunition pouch for 'Gunpowder' troops in your party." />
  <string id="tor_careerchoice_description.ImperialGunnerySchoolKeystone" text="{=str_ie_gunks}Scatter: 9 pellets (7 repeater). Munition shots give gunners in 10m +30% reload for 10s." />

  <string id="tor_careerchoice_description.CannonsOfTheEmpirePassive1" text="{=str_ie_can1}+20% personal reload speed." />
  <string id="tor_careerchoice_description.CannonsOfTheEmpirePassive2" text="{=str_ie_can2}+25% party carrying capacity." />
  <string id="tor_careerchoice_description.CannonsOfTheEmpirePassive3" text="{=str_ie_can3}You may deploy 2 additional Great Cannons without having them in your inventory. +2 artillery limit." />
  <string id="tor_careerchoice_description.CannonsOfTheEmpirePassive4" text="{=str_ie_can4}+10% 'Physical' and 'Fire' resistance for 'Gunpowder' troops." />
  <string id="tor_careerchoice_description.CannonsOfTheEmpireKeystone" text="{=str_ie_canks}Explosive Shot: +1m radius. Doubles 'Gunpowder' and 'Engineering' scaling." />

  <string id="tor_careerchoice_description.LeonardosLegacyPassive1" text="{=str_ie_leo1}+5 Companion limit." />
  <string id="tor_careerchoice_description.LeonardosLegacyPassive2" text="{=str_ie_leo2}+20% 'Fire' resistance for you and all troops." />
  <string id="tor_careerchoice_description.LeonardosLegacyPassive3" text="{=str_ie_leo3}+25% personal 'Fire' damage." />
  <string id="tor_careerchoice_description.LeonardosLegacyPassive4" text="{=str_ie_leo4}Experimental Munition also applies to all Companions wielding a firearm." />
  <string id="tor_careerchoice_description.LeonardosLegacyKeystone" text="{=str_ie_leoks}Munition shots give gunners in 10m +30% reload, +15% damage for 10s." />

  <string id="tor_careerchoice_description.WhirlingCavalcadeOfDeathPassive1" text="{=str_ie_cav1}Single-shot guns fire 2 projectiles at 75% damage, excluding blunderbusses." />
  <string id="tor_careerchoice_description.WhirlingCavalcadeOfDeathPassive2" text="{=str_ie_cav2}+15% 'Physical' damage for 'Gunpowder' troops." />
  <string id="tor_careerchoice_description.WhirlingCavalcadeOfDeathPassive3" text="{=str_ie_cav3}+10% 'Physical' resistance for 'Gunpowder' troops." />
  <string id="tor_careerchoice_description.WhirlingCavalcadeOfDeathPassive4" text="{=str_ie_cav4}+10% personal 'Physical' resistance." />
  <string id="tor_careerchoice_description.WhirlingCavalcadeOfDeathKeystone" text="{=str_ie_cavks}Increases the effectiveness of Experimental Munition. +50% misfire chance, +severity." />
</strings>
